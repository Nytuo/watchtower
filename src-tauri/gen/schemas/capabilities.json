{
  "default": {
    "identifier": "default",
    "description": "Capability for the main window",
    "local": true,
    "windows": ["main"],
    "permissions": [
      "core:default",
      "dialog:default",
      "fs:default",
      "shell:default",
      "store:default",
      "core:event:default",
      "core:window:default",
      "core:window:allow-set-title",
      "core:window:allow-close",
      "core:window:allow-minimize",
      "core:window:allow-maximize",
      "core:window:allow-set-size"
    ]
  }
}
